# ============================================================
# Vertrag.ma — Environment configuration
# Copy to .env and fill in the values.
# ============================================================

# --- Database ------------------------------------------------
# Production MongoDB connection. Without it, a local in-memory
# MongoDB is started automatically (dev preview mode only).
MONGODB_URI=mongodb://localhost:27017
DB_NAME=vertrag_ma

# --- App -----------------------------------------------------
NEXT_PUBLIC_APP_URL=https://vertrag.ma

# --- Auth ----------------------------------------------------
JWT_SECRET=change-me-to-a-long-random-string
# Set to true only when serving over plain HTTP (no TLS).
ALLOW_HTTP_COOKIES=false

# --- Email (Brevo) -------------------------------------------
BREVO_API_KEY=xkeysib-...
BREVO_SENDER_EMAIL=noreply@vertrag.ma

# --- Cloudinary (PDF uploads) --------------------------------
# PDFs are uploaded as RAW resources and delivered via
#   https://res.cloudinary.com/<cloud>/raw/upload/...
#
# REQUIRED ACCOUNT SETTING (the #1 cause of HTTP 401 on PDF links):
# Cloudinary DISABLES PDF/ZIP delivery by default on accounts. When off,
# EVERY PDF link returns 401 "deny or ACL failure" — image, raw, auto and
# even signed URLs are all blocked (images still work fine).
# Fix (once, ~30s): Cloudinary Console → Settings (gear) → Security →
# enable "Allow delivery of PDF and ZIP files" → Save.
# Direct link: https://console.cloudinary.com/settings/security
#
# Every uploaded link is verified after upload; if it is not publicly
# reachable the upload fails with an explicit error (nothing is persisted).
# Admins can self-diagnose anytime: Admin → Paramètres → « Tester la
# distribution PDF ».
# Option A — single URL (recommended):
# CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME
# Option B — separate variables:
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Misc ----------------------------------------------------
# Set to "test" to disable rate limiting (dev only).
DISABLE_RATE_LIMIT=
