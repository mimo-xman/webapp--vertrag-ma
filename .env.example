# ============================================================
# Vertrag.ma — Environment configuration
# Copy to .env and fill in the values.
# ============================================================

# --- Database ------------------------------------------------
# Production MongoDB connection. Without it, a local in-memory
# MongoDB is started automatically (dev preview mode only).
MONGODB_URI=mongodb://localhost:27017
DB_NAME=vertrag_ma

# --- App -----------------------------------------------------
NEXT_PUBLIC_APP_URL=https://vertrag.ma

# --- Auth ----------------------------------------------------
JWT_SECRET=change-me-to-a-long-random-string
# Set to true only when serving over plain HTTP (no TLS).
ALLOW_HTTP_COOKIES=false

# --- Email (Brevo) -------------------------------------------
BREVO_API_KEY=xkeysib-...
BREVO_SENDER_EMAIL=noreply@vertrag.ma

# --- Cloudinary (PDF uploads) --------------------------------
# PDFs are uploaded as RAW resources and delivered via
#   https://res.cloudinary.com/<cloud>/raw/upload/...
# (Cloudinary blocks PDF delivery through the `image` pipeline on some
#  accounts — HTTP 401 "deny or ACL failure". Raw delivery is not affected.)
# Every uploaded link is verified after upload; if it is not publicly
# reachable the upload fails with an explicit error (nothing is persisted).
# Option A — single URL (recommended):
# CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME
# Option B — separate variables:
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Misc ----------------------------------------------------
# Set to "test" to disable rate limiting (dev only).
DISABLE_RATE_LIMIT=
